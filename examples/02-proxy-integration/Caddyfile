http://public.example.test:8080 {
	reverse_proxy public-app:80
}

https://protected.example.test:8443 {
	tls internal
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy protected-app:80
}

https://auth.example.test:8443 {
	tls internal
	reverse_proxy authelia:9091
}

:8080 {
	respond "unknown test host" 404
}
